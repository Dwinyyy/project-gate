# Copy to .env; never commit real credentials. Local example only.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://hunter_runtime:local-development-only@127.0.0.1:54322/postgres
# Separate migration owner credentials. Not loaded by API/worker.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false
DATABASE_SSL_CA_PATH=
# Public Auth origin and publishable browser key. The API returns only these two values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_local-development-placeholder
# Never add a service-role or secret key to this file or any VITE_* variable.
# Dedicated disposable test database; integration tests refuse production environments.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/hunter_test

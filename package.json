{
  "name": "hunter-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,player \"pnpm dev:api\" \"pnpm dev:player\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:player": "vite --config apps/player/vite.config.ts",
    "dev:operator": "vite --config apps/operator/vite.config.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "build": "pnpm build:server && pnpm build:player && pnpm build:operator && pnpm check:boundaries",
    "build:server": "tsup",
    "build:player": "tsx scripts/build-player-with-operator.ts",
    "build:operator": "vite build --config apps/operator/vite.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm check:secrets && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-json-schema-to-ts": "5.0.0",
    "@hunter-world/client": "workspace:*",
    "@hunter-world/contracts": "workspace:*",
    "@hunter-world/database": "workspace:*",
    "@hunter-world/server": "workspace:*",
    "@hunter-world/ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "json-schema-to-ts": "3.1.1",
    "pg": "8.23.0",
    "pg-boss": "12.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/config": "0.7.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
